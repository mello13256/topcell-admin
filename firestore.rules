rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /produtos/{produtoId} {
      // Qualquer pessoa pode LER o catálogo (app do cliente não faz login).
      allow read: if true;
      // Só quem passou pela autenticação anônima do app de gerenciamento
      // (ou seja, quem abriu o app e digitou o PIN) pode escrever.
      allow write: if request.auth != null;
    }
  }
}
